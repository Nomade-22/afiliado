# Configure no painel da Vercel > Project Settings > Environment Variables
# Obrigatórias para habilitar o painel administrativo:
ADMIN_PASSWORD=senha-forte-configurada-na-vercel
SESSION_SECRET=chave-aleatoria-longa-de-pelo-menos-32-caracteres
# Banco Neon (necessário para salvar produtos, configurações e cliques entre usuários):
DATABASE_URL=postgresql://... 
# Shopee Affiliate Open API (ativação sujeita à aprovação Shopee):
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

{
  "manifest_version": 3,
  "name": "Vivi · Captura Rápida Shopee (Piloto)",
  "version": "0.4.0",
  "description": "Captura manual, contínua ou em lote dos produtos pendentes do piloto Shopee, com gravação autenticada no teste Vivi.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vivi: capturar Shopee (modo rápido/contínuo)"
  },
  "optional_host_permissions": [
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}

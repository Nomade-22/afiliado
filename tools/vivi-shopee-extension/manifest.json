{
  "manifest_version": 3,
  "name": "Vivi · Captura Rápida Shopee (Piloto)",
  "version": "0.7.0",
  "description": "Captura Vivi de até 20 produtos: tenta caminhos do mesmo anúncio, reúne fotos/descrições e atualiza o catálogo com segurança.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vivi: capturar Shopee (modo rápido/contínuo)"
  },
  "optional_host_permissions": [
    "https://shopee.com.br/*",
    "https://www.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ofertas-da-vivi.vercel.app/adm*"
      ],
      "js": [
        "adm-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
